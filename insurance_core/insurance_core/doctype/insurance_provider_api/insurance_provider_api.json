  ],
  "fields": [
    {
      "fieldname": "insurance_provider",
      "fieldtype": "Link",
      "label": "Insurance Provider",
      "options": "Insurance Provider",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "bold": 1
    },
    {
      "fieldname": "is_enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "0",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "When enabled, RFQ flow can call this API for matching LOBs"
    },
    {
      "fieldname": "environment",
      "fieldtype": "Select",
      "label": "Environment",
      "options": "Sandbox\nProduction",
      "default": "Sandbox",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_main",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "supported_lobs",
      "fieldtype": "Small Text",
      "label": "Supported Lines of Business",
      "description": "Comma-separated: Health, Auto, Life, Property, Travel, Marine, Liability. Blank = all."
    },
    {
      "fieldname": "request_timeout",
      "fieldtype": "Int",
      "label": "Request Timeout (seconds)",
      "default": "30"
    },
    {
      "fieldname": "section_endpoint",
      "fieldtype": "Section Break",
      "label": "Endpoint"
    },
    {
      "fieldname": "base_url",
      "fieldtype": "Data",
      "label": "Base URL",
      "reqd": 1,
      "options": "URL",
      "description": "e.g. https://api.insurer.com/v1"
    },
    {
      "fieldname": "quote_path",
      "fieldtype": "Data",
      "label": "Quote Path",
      "default": "/quotes",
      "description": "Path appended to Base URL, e.g. /quotes or /health/premium"
    },
    {
      "fieldname": "http_method",
      "fieldtype": "Select",
      "label": "HTTP Method",
      "options": "POST\nGET",
      "default": "POST"
    },
    {
      "fieldname": "section_auth",
      "fieldtype": "Section Break",
      "label": "Authentication"
    },
    {
      "fieldname": "auth_type",
      "fieldtype": "Select",
      "label": "Auth Type",
      "options": "API Key\nBearer Token\nBasic\nOAuth2\nCustom Header\nNone",
      "default": "API Key",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "auth_header_name",
      "fieldtype": "Data",
      "label": "Auth Header Name",
      "default": "X-API-Key",
      "depends_on": "eval:doc.auth_type=='API Key' || doc.auth_type=='Custom Header'",
      "description": "Header name for API Key / Custom Header auth"
    },
    {
      "fieldname": "column_break_auth",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "api_key",
      "fieldtype": "Password",
      "label": "API Key / Bearer Token",
      "depends_on": "eval:['API Key','Bearer Token','Custom Header'].includes(doc.auth_type)"
    },
    {
      "fieldname": "username",
      "fieldtype": "Data",
      "label": "Username",
      "depends_on": "eval:doc.auth_type=='Basic'"
    },
    {
      "fieldname": "password",
      "fieldtype": "Password",
      "label": "Password",
      "depends_on": "eval:doc.auth_type=='Basic'"
    },
    {
      "fieldname": "client_id",
      "fieldtype": "Data",
      "label": "Client ID",
      "depends_on": "eval:doc.auth_type=='OAuth2'"
    },
    {
      "fieldname": "client_secret",
      "fieldtype": "Password",
      "label": "Client Secret",
      "depends_on": "eval:doc.auth_type=='OAuth2'"
    },
    {
      "fieldname": "oauth_token_url",
      "fieldtype": "Data",
      "label": "OAuth Token URL",
      "options": "URL",
      "depends_on": "eval:doc.auth_type=='OAuth2'"
    },
    {
      "fieldname": "section_templates",
      "fieldtype": "Section Break",
      "label": "Request / Response Mapping"
    },
    {
      "fieldname": "request_body_template",
      "fieldtype": "Code",
      "label": "Request Body Template (JSON)",
      "options": "JSON",
      "description": "JSON with optional Jinja placeholders: {{ line_of_business }}, {{ sum_insured }}, {{ age }}, {{ client_type }}, {{ client }}, {{ opportunity }}"
    },
    {
      "fieldname": "response_mapping",
      "fieldtype": "Code",
      "label": "Response Mapping (JSON)",
      "options": "JSON",
      "description": "Map insurer response paths to our fields. Example: {\"net_premium\": \"data.premium\", \"tax\": \"data.tax\", \"total_premium\": \"data.total\", \"sum_insured\": \"data.sumInsured\", \"valid_upto\": \"data.validTill\", \"reference\": \"data.quoteId\"}"
    },
    {
      "fieldname": "section_test",
      "fieldtype": "Section Break",
      "label": "Connection Test"
    },
    {
      "fieldname": "last_tested_on",
      "fieldtype": "Datetime",
      "label": "Last Tested On",
      "read_only": 1
    },
    {
      "fieldname": "last_test_status",
      "fieldtype": "Select",
      "label": "Last Test Status",
      "options": "\nSuccess\nFailed",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_test",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "last_error",
      "fieldtype": "Small Text",
      "label": "Last Error",
      "read_only": 1
    },
    {
      "fieldname": "section_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text Editor",
      "label": "Internal Notes"
    }
  ],
  "modified": "2026-09-16 00:00:00",
  "modified_by": "Administrator",
  "module": "Insurance Core",
  "name": "Insurance Provider API",
  "naming_rule": "Expression",
